{
  "name": "bill-badran",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run ink && next dev --hostname 127.0.0.1",
    "build": "npm run ink && node --import tsx scripts/content.ts validate && node --import tsx scripts/launch.ts && next build",
    "ink": "node --import tsx scripts/build-ink.tsx",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "content": "node --import tsx scripts/content.ts",
    "launch:check": "node --import tsx scripts/launch.ts --strict",
    "protections:check": "node --import tsx scripts/protections.ts",
    "format": "prettier --write .",
    "guide": "node --import tsx guide/build.tsx"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/newsreader": "^5.2.8",
    "@fontsource/source-sans-3": "^5.3.0",
    "next": "16.3.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agent-browser": "latest",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
