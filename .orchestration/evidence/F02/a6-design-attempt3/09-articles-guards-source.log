    48	) {
    49	  const {
    50	    status,
    51	    reviewer,
    52	    publicationDate,
    53	    substantiveReviewDate,
    54	    nextReviewDate,
    55	    ...substance
    56	  } = data;
    57	  void [
    58	    status,
    59	    reviewer,
    60	    publicationDate,
    61	    substantiveReviewDate,
    62	    nextReviewDate,
    63	  ];
    64	  return createHash("sha256")
    65	    .update(JSON.stringify({ ...substance, body }))
