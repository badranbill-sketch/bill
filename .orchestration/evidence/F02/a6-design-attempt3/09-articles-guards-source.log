   113	export function approvedArticle(a: Article) {
   114	  const evidence = approvals()[a.filename];
   115	  return (
   116	    a.status === "published" &&
   117	    !!a.author &&
   118	    !!a.reviewer &&
   119	    !!a.publicationDate &&
   120	    !!a.substantiveReviewDate &&
   121	    !!a.nextReviewDate &&
   122	    !!evidence &&
   123	    evidence.sha256 === a.hash &&
   124	    /^https:\/\/github.com\/[^/]+\/[^/]+\/pull\/\d+$/.test(
   125	      evidence.pullRequest,
   126	    ) &&
   127	    !!evidence.humanReview &&
   128	    (!a.firmApprovalRequired || !!evidence.firmApproval)
   129	  );
   130	}
   131	export function visibleArticles(lang: Language, review = false) {
