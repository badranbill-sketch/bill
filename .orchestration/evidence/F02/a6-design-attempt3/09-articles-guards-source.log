    68	export function parseArticle(raw: string, filename: string): Article {
    69	  const match = raw.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
    70	  if (!match) throw Error(`Invalid frontmatter: ${filename}`);
    71	  const data = articleSchema.parse(JSON.parse(match[1]));
    72	  if (match[2].trim().split(/\s+/).length < 220)
    73	    throw Error(`Article too short: ${filename}`);
    74	  if (/<\/?(?:script|iframe)|javascript:/i.test(match[2]))
    75	    throw Error(`Unsafe content: ${filename}`);
    76	  // French spacing is applied for display only, so the approved fingerprint
    77	  // stays that of the file as written.
    78	  const typo = (text: string) =>
    79	    data.language === "fr"
    80	      ? text.replace(/ ([:;!?»])/g, "\u00a0$1").replace(/« /g, "«\u00a0")
    81	      : text;
    82	  return {
    83	    ...data,
    84	    title: typo(data.title),
    85	    description: typo(data.description),
    86	    body: typo(match[2]),
    87	    filename,
    88	    hash: contentFingerprint(data, match[2]),
    89	  };
    90	}
