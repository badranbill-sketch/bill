{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bill.contracts.local/email-eligibility-registry/1.0",
  "title": "Shape of contracts/email-eligibility.json 1.0 (harness schema, F02 data lane)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "contract_version", "status", "registry_schema", "sources", "related_contracts", "classification_rule", "budget", "priority_scale", "anchors", "offset_notation", "suppression_codes", "common_pre_send_checks", "runtime_gate", "templates"],
  "properties": {
    "contract_id": {"const": "https://bill.contracts.local/email-eligibility/1.0"},
    "contract_version": {"const": "1.0"},
    "status": {"type": "string"},
    "registry_schema": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "string"}},
    "related_contracts": {"type": "object"},
    "classification_rule": {"type": "string"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "provider_daily_quota", "quota_window", "hard_stop", "soft_daily_budget", "operational_reserved", "promotional_max", "approval", "counting_rule", "spill_rules", "frequency_caps", "forecast"],
      "properties": {
        "provider": {"const": "brevo"},
        "provider_daily_quota": {"type": "object", "required": ["value", "status"], "properties": {"value": {"type": "integer"}, "status": {"const": "source_fact_at_plan_time"}}},
        "quota_window": {"type": "object"},
        "hard_stop": {"$ref": "#/$defs/proposed_number"},
        "soft_daily_budget": {"$ref": "#/$defs/proposed_number"},
        "operational_reserved": {"$ref": "#/$defs/proposed_number"},
        "promotional_max": {"$ref": "#/$defs/proposed_number"},
        "approval": {"type": "object", "required": ["owner", "state"], "properties": {"state": {"const": "not_approved"}}},
        "counting_rule": {"type": "string"},
        "spill_rules": {"type": "array", "items": {"type": "string"}},
        "frequency_caps": {"type": "array", "items": {"type": "object", "required": ["id", "rule", "status"]}},
        "forecast": {"type": "object", "required": ["formula", "definitions", "rule", "status"]}
      }
    },
    "priority_scale": {"type": "object"},
    "anchors": {"type": "object"},
    "offset_notation": {"type": "string"},
    "suppression_codes": {"type": "object"},
    "common_pre_send_checks": {"type": "array", "items": {"type": "string"}},
    "runtime_gate": {"type": "object", "additionalProperties": false,
      "required": ["rule_ids", "defined_in", "capability_rule", "nonproduction_substitutes", "class_flags", "class_flags_rule", "on_fail", "consistency"],
      "properties": {
        "rule_ids": {"const": ["FF-RUN-1", "FF-RUN-2", "FF-RUN-3"]},
        "defined_in": {"type": "string"},
        "capability_rule": {"type": "string"},
        "nonproduction_substitutes": {"type": "object", "additionalProperties": false, "required": ["public_launch", "checkout_live"],
          "properties": {"public_launch": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                         "checkout_live": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
        "class_flags": {"type": "object", "additionalProperties": false, "required": ["operational", "promotional"],
          "properties": {"operational": {"const": []}, "promotional": {"const": ["marketing_dispatch"]}}},
        "class_flags_rule": {"type": "string"},
        "on_fail": {"type": "object", "additionalProperties": false, "required": ["transition", "defer_reason", "attempt"],
          "properties": {"transition": {"const": "T7"}, "defer_reason": {"const": "capability_disabled"}, "attempt": {"const": false}}},
        "consistency": {"type": "string"}}},
    "templates": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/template"}}
  },
  "$defs": {
    "proposed_number": {"type": "object", "required": ["value", "status"], "properties": {"value": {"type": "integer", "minimum": 0}, "status": {"const": "proposed"}}},
    "duration": {"type": "string", "pattern": "^-?P(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$"},
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "template_id", "purpose", "proposed_class", "classification_status", "capability", "controlling_flags", "consent", "trigger_event_types", "timing", "expiry", "suppressions", "pre_send_checks", "priority", "daily_budget", "frequency_caps", "resource_ref", "once_per", "notes"],
      "properties": {
        "id": {"type": "string", "pattern": "^E(?:0[1-9]|1[0-6])$"},
        "template_id": {"type": "string", "pattern": "^e(?:0[1-9]|1[0-6])$"},
        "purpose": {"type": "string", "minLength": 3},
        "proposed_class": {"enum": ["operational", "promotional"]},
        "classification_status": {"const": "pending_G5"},
        "alternate_class": {"type": "object", "additionalProperties": false,
          "required": ["class", "consent_purpose", "when", "additional_controlling_flags", "additional_suppressions", "priority", "daily_budget_pool", "frequency_caps"],
          "properties": {"class": {"const": "promotional"}, "consent_purpose": {"enum": ["nurture", "workshop-followup"]}, "when": {"type": "string"},
                         "additional_controlling_flags": {"type": "array", "contains": {"const": "marketing_dispatch"}, "items": {"enum": ["marketing_dispatch"]}},
                         "additional_suppressions": {"type": "array", "items": {"type": "string"}},
                         "priority": {"type": "integer", "minimum": 5, "maximum": 9},
                         "daily_budget_pool": {"const": "promotional"},
                         "frequency_caps": {"type": "array", "items": {"enum": ["FC-1", "FC-2"]}}}},
        "capability": {"type": "string"},
        "controlling_flags": {"type": "array", "items": {"enum": ["public_launch", "checkout_live", "marketing_dispatch", "automatic_publication", "paid_ads", "third_party_tracking"]}},
        "consent": {"type": "object", "additionalProperties": false, "required": ["required", "purpose", "rule"],
                    "properties": {"required": {"type": "boolean"}, "purpose": {"enum": ["nurture", "workshop-followup", null]}, "rule": {"type": "string"}}},
        "trigger_event_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "timing": {"type": "object", "additionalProperties": false, "required": ["anchor", "offset", "rule"],
                   "properties": {"anchor": {"type": "string"}, "offset": {"$ref": "#/$defs/duration"}, "rule": {"type": "string"}}},
        "expiry": {"type": "object", "additionalProperties": false, "required": ["anchor", "offset", "rule"],
                   "properties": {"anchor": {"type": "string"}, "offset": {"$ref": "#/$defs/duration"}, "rule": {"type": "string"}}},
        "suppressions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "pre_send_checks": {"type": "array", "items": {"type": "string"}},
        "priority": {"type": "integer", "minimum": 0, "maximum": 9},
        "daily_budget": {"type": "object", "additionalProperties": false, "required": ["participates", "pool"],
                         "properties": {"participates": {"const": true}, "pool": {"enum": ["operational_reserved", "promotional"]}}},
        "frequency_caps": {"type": "array", "items": {"enum": ["FC-1", "FC-2"]}},
        "resource_ref": {"enum": [null, "wev", "ord", "rgt", "bkg"]},
        "once_per": {"type": "string"},
        "sender_of_record": {"type": "string"},
        "notes": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"proposed_class": {"const": "promotional"}}},
         "then": {"properties": {"consent": {"properties": {"required": {"const": true}, "purpose": {"type": "string"}}},
                                 "priority": {"minimum": 5}, "daily_budget": {"properties": {"pool": {"const": "promotional"}}},
                                 "suppressions": {"allOf": [{"contains": {"const": "consent_withdrawn"}}, {"contains": {"const": "consent_missing"}}]},
                                 "controlling_flags": {"contains": {"const": "marketing_dispatch"}}}}},
        {"if": {"properties": {"proposed_class": {"const": "operational"}}},
         "then": {"properties": {"priority": {"maximum": 3}, "daily_budget": {"properties": {"pool": {"const": "operational_reserved"}}}}}},
        {"properties": {"suppressions": {"contains": {"const": "provider_blocklist"}}}},
        {"properties": {"suppressions": {"contains": {"const": "not_allowlisted"}}}}
      ]
    }
  }
}
