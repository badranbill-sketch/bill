{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bill.contracts.local/event-envelope/1.0",
  "title": "Operational event envelope 1.0",
  "description": "Exactly the 04 §3 envelope. Closed shape: no payload, no form body, no financial field. Per-type rules (subject kind, resource kind, allowed sources, consent_reference required/forbidden) are in allOf. Semantics: event-envelope.md. Status: proposed (F02), not accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "type",
    "occurred_at",
    "subject_id",
    "locale",
    "source",
    "resource_id",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "$ref": "#/$defs/uuid"
    },
    "type": {
      "$ref": "#/$defs/event_type"
    },
    "occurred_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "subject_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/subject_contact"
        },
        {
          "$ref": "#/$defs/subject_content_item"
        },
        {
          "$ref": "#/$defs/subject_job"
        }
      ],
      "description": "Internal random ID of the entity the event is about (con_ contact, cnt_ content item, job_ delivery job). Never an email or name."
    },
    "locale": {
      "enum": [
        "fr",
        "en"
      ]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "resource_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/resource_guide_version"
        },
        {
          "$ref": "#/$defs/resource_consent_wording"
        },
        {
          "$ref": "#/$defs/resource_webinar_event"
        },
        {
          "$ref": "#/$defs/resource_workshop_version"
        },
        {
          "$ref": "#/$defs/resource_book_order"
        },
        {
          "$ref": "#/$defs/resource_consultation_right"
        },
        {
          "$ref": "#/$defs/resource_booking"
        },
        {
          "$ref": "#/$defs/resource_content_version"
        },
        {
          "$ref": "#/$defs/resource_template_version"
        }
      ],
      "description": "Approved resource reference: an internal entity ID, or a versioned registry code. On contact-subject events a registry code has a closed key and a hash version (PB-ID-3); content-item codes are asset-manifest 1.0 asset IDs. Every registry code must also be a member of the approved resource registry, which the schema cannot see (runtime rule PB-ID-5 / EV-REG-1, event-envelope.md §4.2)."
    },
    "consent_reference": {
      "$ref": "#/$defs/consent_event_id"
    },
    "idempotency_key": {
      "$ref": "#/$defs/idempotency_key"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "guide.requested"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_guide_version"
          },
          "source": {
            "enum": [
              "site.guide_request"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "marketing.opted_in"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_consent_wording"
          },
          "source": {
            "enum": [
              "site.consent_capture",
              "site.optin_confirmation",
              "site.preferences"
            ]
          }
        },
        "required": [
          "consent_reference"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "marketing.withdrawn"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_consent_wording"
          },
          "source": {
            "enum": [
              "site.unsubscribe",
              "site.preferences",
              "provider.brevo_webhook",
              "operator.suppression"
            ]
          }
        },
        "required": [
          "consent_reference"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "webinar.registered"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_webinar_event"
          },
          "source": {
            "enum": [
              "site.webinar_registration",
              "operator.reconciliation"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "webinar.cancelled"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_webinar_event"
          },
          "source": {
            "enum": [
              "site.webinar_registration",
              "site.preferences",
              "operator.reconciliation"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "webinar.join_clicked"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_webinar_event"
          },
          "source": {
            "enum": [
              "site.join_redirect"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "webinar.attendance_verified"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_webinar_event"
          },
          "source": {
            "enum": [
              "provider.meet_attendance",
              "operator.reconciliation"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "workshop.access_requested"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_workshop_version"
          },
          "source": {
            "enum": [
              "site.workshop_access"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "workshop.completed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_workshop_version"
          },
          "source": {
            "enum": [
              "site.workshop_completion"
            ]
          }
        },
        "required": [
          "consent_reference"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "book.payment_confirmed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_book_order"
          },
          "source": {
            "enum": [
              "provider.stripe_webhook"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "book.refunded"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_book_order"
          },
          "source": {
            "enum": [
              "provider.stripe_webhook"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "book.dispatched"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_book_order"
          },
          "source": {
            "enum": [
              "operator.fulfilment"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "consultation.redeemed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_consultation_right"
          },
          "source": {
            "enum": [
              "provider.booking_sync",
              "operator.reconciliation"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "meeting.confirmed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_booking"
          },
          "source": {
            "enum": [
              "provider.booking_sync",
              "operator.reconciliation"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "meeting.cancelled"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_booking"
          },
          "source": {
            "enum": [
              "provider.booking_sync",
              "operator.reconciliation"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "meeting.held"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_contact"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_booking"
          },
          "source": {
            "enum": [
              "operator.reconciliation"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "content.draft_created"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_content_item"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_content_version"
          },
          "source": {
            "enum": [
              "editorial.draft_job"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "content.approved"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_content_item"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_content_version"
          },
          "source": {
            "enum": [
              "editorial.approval_ledger"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "content.published"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_content_item"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_content_version"
          },
          "source": {
            "enum": [
              "editorial.publication_handoff"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "delivery.failed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/subject_job"
          },
          "resource_id": {
            "$ref": "#/$defs/resource_template_version"
          },
          "source": {
            "enum": [
              "system.dispatcher",
              "provider.brevo_webhook"
            ]
          },
          "consent_reference": {
            "not": {},
            "description": "Forbidden for this type: consent is never carried by, or inferred from, a non-consent event."
          }
        }
