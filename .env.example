# Run npm run dev without credentials for a local review.
PUBLIC_LAUNCH=false
# Required only for local production preview (bind to 127.0.0.1):
LOCAL_REVIEW=true
# On hosted review deployments, protect the whole site with credentials.
# VERCEL is set by Vercel. LOCAL_REVIEW is ignored there.
REVIEW_ENABLED=false
REVIEW_USER=
REVIEW_PASSWORD=
# Optional inquiry adapter. ALL values + ENABLE_CONTACT required.
ENABLE_CONTACT=false
RESEND_API_KEY=
MAIL_FROM=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
# False except behind a reverse proxy that overwrites x-forwarded-for.
TRUST_PROXY_IP=false
# Optional authorized GitHub workflow:
GITHUB_REPOSITORY=
CONTENT_REVIEWERS=
FIRM_REVIEWERS=
ALLOW_CONTENT_PR=false
