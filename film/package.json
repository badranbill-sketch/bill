{
  "name": "bill-badran-film",
  "version": "1.0.0",
  "description": "Bill Badran — explainer film (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/captions": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/media": "4.0.529",
    "@remotion/paths": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.529",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "voice:scratch": "bash tools/voice.sh scratch",
    "voice:bill": "bash tools/voice.sh bill",
    "music": "python3 tools/music.py",
    "music:synth": "python3 tools/score.py",
    "sfx": "python3 tools/sfx.py",
    "guide-assets": "bash tools/guide_assets.sh",
    "render": "node tools/render.mjs",
    "render:captioned": "node tools/render.mjs --captioned",
    "qc": "node tools/stills.mjs --qc",
    "scene": "node tools/scene-stills.mjs",
    "voice:import": "bash tools/voice.sh import assets/voice/jonathan/A.mp3 assets/voice/jonathan/B.mp3 assets/voice/jonathan/C.mp3 assets/voice/jonathan/D.mp3"
  },
  "sideEffects": [
    "*.css"
  ]
}
