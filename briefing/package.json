{
  "name": "bill-plan-briefing",
  "version": "0.1.0",
  "private": true,
  "description": "Internal briefing video for Arnaud and Bill: the plan and what it takes (Remotion). Not for publication.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "remotion studio",
    "ink": "node scripts/prep-ink.mjs",
    "proof": "node scripts/proof.mjs out",
    "qa": "node --experimental-strip-types --no-warnings scripts/qa.mjs",
    "lint": "tsc --noEmit",
    "stills": "node --experimental-strip-types --no-warnings scripts/stills.mjs",
    "render": "remotion render Briefing out/plan-briefing-en.mp4 --codec=h264 --crf=18 --concurrency=2",
    "docs": "node docs/build.mjs",
    "docs:preview": "${DOCS_PY:-python3} docs/preview.py",
    "docs:sample": "node docs/build.mjs docs/samples/sample.md"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/paths": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "markdown-it": "14.3.2",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
